{
    "document_type": "aadhaar",
    "fields": [
        {
            "name": "name",
            "type": "string",
            "required": true
        },
        {
            "name": "aadhaar_number",
            "type": "string",
            "required": true,
            "pattern": "^[0-9]{12}$",
            "normalize": "remove_all_whitespace"
        },
        {
            "name": "date_of_birth",
            "type": "date",
            "required": false
        },
        {
            "name": "gender",
            "type": "string",
            "required": false
        },
        {
            "name": "address",
            "type": "string",
            "required": false
        }
    ],
    "metadata": {
        "description": "Indian Aadhaar identity document"
    }
}